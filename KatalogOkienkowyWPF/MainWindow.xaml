<Window x:Class="KatalogOkienkowyWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowyWPF"
        mc:Ignorable="d"
        Title="KatalogOkienkwowyWPF" Height="500" Width="700" Background="#FF4E3939">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Text="Katalog produktów"
            FontSize="24"
            FontWeight="Bold" />

        <Button Grid.Row="0" Grid.Column="1" Content="Odśwież" Width="100" />
        
        <TextBlock Grid.Row="1" 
                   Grid.Column="0"
                   Text="Tu pojewi się lista produktów" 
                   FontSize="18" 
                   Margin="0,10,0,10" />
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Dodaj" Width="100" Margin="0,0,10,0" />
        <Button Content="Usuń" Width="100" Margin="0,0,10,0" />
        <Button Content="Zamknij" Width="100" />
        </StackPanel>
    </Grid>

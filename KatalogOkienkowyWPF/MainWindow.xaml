<Window x:Class="KatalogOkienkowyWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowyWPF"
        mc:Ignorable="d"
        Title="KatalogOkienkwowyWPF" Height="500" Width="700" Background="#FF4E3939">
    <StackPanel Margin="20" x:Name="GlownyStackPanel">
        <TextBlock Text="Katalog Okienkowy WPF"
                   FontSize="24"
                   FontWeight="Bold"
                   />
        <TextBlock x:Name="EtykietaLiczbaProduktow" 
                   Text="Liczba produktów: 0"
                   FontSize="14"
                   Margin="0,10,0,0"
                   />
        <TextBlock x:Name="WartoscMagazynu" 
           Text="Wartość magazynu: 0"
           FontSize="14"
           Margin="0,10,0,0"
           />

        <Button HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Images/plus_icon.png" Width="16" Height="16" Margin="0,0,5,0"/>
                <TextBlock Text="Dodaj produkt"
                       FontSize="16"
                       FontWeight="Bold" />
                </StackPanel>
        </Button>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Content="Produkt 1" Margin="5" />
            <Button Grid.Row="0" Grid.Column="1" Content="Produkt 2" Margin="5" />
            <Button Grid.Row="1" Grid.Column="0" Content="Produkt 3" Margin="5" />
            <Button Grid.Row="1" Grid.Column="1" Content="Produkt 4" Margin="5" />
        </Grid>
                
        
        
    </StackPanel>
</Window>

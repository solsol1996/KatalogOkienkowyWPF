<Window x:Class="KatalogOkienkowyWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowyWPF"
        mc:Ignorable="d"
        Title="KatalogOkienkwowyWPF" Height="500" Width="700" Background="#FF4E3939">
        
    <Grid Margin="10" x:Name="GlownyStackPanel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Text="Katalog produktów"
            FontSize="24"
            FontWeight="Bold" />

        <Button Grid.Row="0" Grid.Column="1" Content="Odśwież" Width="100" />
        
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,10">
            <TextBlock Text="Tu pojawi się lista produktów"
                       FontSize="18" />
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />                
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa produktu:" Margin="0,0,10,10" />
            <TextBox Grid.Row="0" Grid.Column="1" Width="200" Margin="0,0,0,10" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cena produktu:" Margin="0,0,10,10" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="200" Margin="0,0,0,10" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ilość produktu:" Margin="0,0,10,10" />
            <TextBox Grid.Row="2" Grid.Column="1" Width="200" Margin="0,0,0,10" />
        </Grid>
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="EtykietaLiczbaProduktow"
                           Text="Liczba produktów: 0" />
                <TextBlock x:Name="EtykietaWartoscMagazynu"
                           Text="Wartość magazynu: 0 zł" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Dodaj" Width="100" Margin="0,0,10,0" />
                <Button Content="Usuń" Width="100" Margin="0,0,10,0" />
                <Button Content="Zamknij" Width="100" />
            </StackPanel>
        </Grid>
    </Grid>
